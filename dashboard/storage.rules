rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(
          /databases/(default)/documents/admin_users/$(request.auth.uid)
        );
    }

    function isEnabledJetsonUploader() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/device_uploaders/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/device_uploaders/$(request.auth.uid)
        ).data.enabled == true;
    }

    function isOwnedJetsonWrite() {
      return request.resource != null
        && request.resource.metadata.uploaderUid == request.auth.uid
        && (resource == null
          || resource.metadata.uploaderUid == request.auth.uid);
    }

    function isJetsonImage(runId) {
      return isEnabledJetsonUploader()
        && isOwnedJetsonWrite()
        && runId.matches('run_[a-f0-9]{24}')
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)')
        && request.resource.metadata.source == 'jetson-runtime'
        && request.resource.metadata.runId == runId
        && request.resource.metadata.captureId.matches('cap_[a-f0-9]{32}')
        && request.resource.metadata.artifactType in [
          'rust_preview',
          'crack_preview'
        ]
        && request.resource.metadata.sha256.matches('^[a-f0-9]{64}$');
    }

    match /dashboard/media/{runId}/{fileName} {
      allow read, write: if isAdmin();
      allow write: if isJetsonImage(runId);
    }

    match /captures/{allPaths=**} {
      allow read, write: if isAdmin();
      allow write: if isEnabledJetsonUploader()
        && isOwnedJetsonWrite()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.source == 'jetson-runtime'
        && request.resource.metadata.runId.matches('run_[a-f0-9]{24}')
        && request.resource.metadata.captureId.matches('cap_[a-f0-9]{32}')
        && request.resource.metadata.artifactType in ['raw', 'analyzed']
        && request.resource.metadata.sha256.matches('^[a-f0-9]{64}$');
    }

    match /dashboard/manifests/{fileName} {
      allow read, write: if isAdmin();
      allow write: if isEnabledJetsonUploader()
        && isOwnedJetsonWrite()
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'application/json'
        && request.resource.metadata.source == 'jetson-runtime'
        && request.resource.metadata.runId.matches('run_[a-f0-9]{24}')
        && request.resource.metadata.sha256.matches('^[a-f0-9]{64}$')
        && fileName == request.resource.metadata.runId + '.json';
    }
  }
}
